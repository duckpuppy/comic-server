<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.comic-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/comic-server</string>
        <string>server</string>
        <string>--library</string>
        <string>/path/to/ComicDb.xml</string>
        <string>--auto-sync</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/comic-server.log</string>

    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/comic-server.error.log</string>

    <key>WorkingDirectory</key>
    <string>/usr/local/var/comic-server</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
