    </Book>
  </Books>
  <ComicLists>
    <!-- Smart List: League Series - Matches books in "League of Extraordinary Gentlemen" series -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-league}" Name="League Series" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookSeriesMatcher" MatchOperator="1">
          <MatchValue>League</MatchValue>
        </ComicBookMatcher>
      </Matchers>
    </Item>
    <!-- Smart List: Top Shelf Publisher - Matches all Top Shelf books -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-topshelf}" Name="Top Shelf Publisher" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookPublisherMatcher" MatchOperator="0">
          <MatchValue>Top Shelf</MatchValue>
        </ComicBookMatcher>
      </Matchers>
    </Item>
    <!-- Smart List: 2009-2011 - Matches books from years 2009-2011 -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-years}" Name="2009-2011" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookYearMatcher" MatchOperator="3">
          <MatchValue>2009</MatchValue>
          <MatchValue2>2011</MatchValue2>
        </ComicBookMatcher>
      </Matchers>
    </Item>
    <!-- Smart List: All Comics - Matches everything (useful for testing full sync) -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-all}" Name="All Comics" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookPublisherMatcher" MatchOperator="0">
          <MatchValue>Top Shelf</MatchValue>
        </ComicBookMatcher>
      </Matchers>
    </Item>
  </ComicLists>
</ComicDatabase>
