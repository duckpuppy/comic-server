  <ComicLists>
    <!-- Smart List: All Comics - Matches all books (for testing full sync) -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-all}" Name="All Comics" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookYearMatcher" MatchOperator="2">
          <MatchValue>1900</MatchValue>
        </ComicBookMatcher>
      </Matchers>
    </Item>

    <!-- Smart List: Ace Magazines - Publisher filter -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-ace}" Name="Ace Magazines" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookPublisherMatcher" MatchOperator="0">
          <MatchValue>Ace Magazines</MatchValue>
        </ComicBookMatcher>
      </Matchers>
    </Item>

    <!-- Smart List: 1950s Comics - Year range filter (1950-1959) -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-1950s}" Name="1950s Comics" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookYearMatcher" MatchOperator="5">
          <MatchValue>1950</MatchValue>
          <MatchValue2>1959</MatchValue2>
        </ComicBookMatcher>
      </Matchers>
    </Item>

    <!-- Smart List: Golden Age - Early comics (1940-1949) -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-golden-age}" Name="Golden Age" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookYearMatcher" MatchOperator="5">
          <MatchValue>1940</MatchValue>
          <MatchValue2>1949</MatchValue2>
        </ComicBookMatcher>
      </Matchers>
    </Item>

    <!-- Smart List: Atomic War! Series - Series filter -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-atomic-war}" Name="Atomic War! Series" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookSeriesMatcher" MatchOperator="1">
          <MatchValue>Atomic War</MatchValue>
        </ComicBookMatcher>
      </Matchers>
    </Item>

    <!-- Smart List: Horror Genre - Genre filter -->
    <Item xsi:type="ComicSmartListItem" Id="{test-list-horror}" Name="Horror Comics" MatcherMode="And">
      <Matchers>
        <ComicBookMatcher xsi:type="ComicBookGenreMatcher" MatchOperator="0">
          <MatchValue>Horror</MatchValue>
        </ComicBookMatcher>
      </Matchers>
    </Item>
  </ComicLists>

