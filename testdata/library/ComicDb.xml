  <ComicLists>
    <!-- Smart List: League Series - Matches books in "League of Extraordinary Gentlemen" series -->
    <ComicList Name="League Series" Type="comicrack:ComicSmartListItem" Id="{test-list-league}">
      <Matchers>
        <Matcher MatchOperator="contains" MatchValue="League">
          <MatchValueList />
        </Matcher>
      </Matchers>
      <GroupMatchers>
        <Group MatcherMode="And">
          <Matchers>
            <Matcher MatchOperator="contains" MatchValue="League">
              <MatchValueList />
            </Matcher>
          </Matchers>
        </Group>
      </GroupMatchers>
      <MatcherMode>And</MatcherMode>
      <AndOrNot>And</AndOrNot>
    </ComicList>
    <!-- Smart List: Top Shelf Publisher - Matches all Top Shelf books -->
    <ComicList Name="Top Shelf Publisher" Type="comicrack:ComicSmartListItem" Id="{test-list-topshelf}">
      <Matchers>
        <Matcher MatchType="Publisher" MatchOperator="equals" MatchValue="Top Shelf">
          <MatchValueList />
        </Matcher>
      </Matchers>
      <GroupMatchers>
        <Group MatcherMode="And">
          <Matchers>
            <Matcher MatchType="Publisher" MatchOperator="equals" MatchValue="Top Shelf">
              <MatchValueList />
            </Matcher>
          </Matchers>
        </Group>
      </GroupMatchers>
      <MatcherMode>And</MatcherMode>
      <AndOrNot>And</AndOrNot>
    </ComicList>
    <!-- Smart List: 2009-2011 - Matches books from years 2009-2011 -->
    <ComicList Name="2009-2011" Type="comicrack:ComicSmartListItem" Id="{test-list-years}">
      <Matchers>
        <Matcher MatchType="Year" MatchOperator="inrange" MatchValue="2009" MatchValue2="2011">
          <MatchValueList />
        </Matcher>
      </Matchers>
      <GroupMatchers>
        <Group MatcherMode="And">
          <Matchers>
            <Matcher MatchType="Year" MatchOperator="inrange" MatchValue="2009" MatchValue2="2011">
              <MatchValueList />
            </Matcher>
          </Matchers>
        </Group>
      </GroupMatchers>
      <MatcherMode>And</MatcherMode>
      <AndOrNot>And</AndOrNot>
    </ComicList>
    <!-- Smart List: All Comics - Matches everything (useful for testing full sync) -->
    <ComicList Name="All Comics" Type="comicrack:ComicSmartListItem" Id="{test-list-all}">
      <Matchers>
        <Matcher MatchType="PageCount" MatchOperator="greater" MatchValue="0">
          <MatchValueList />
        </Matcher>
      </Matchers>
      <GroupMatchers>
        <Group MatcherMode="And">
          <Matchers>
            <Matcher MatchType="PageCount" MatchOperator="greater" MatchValue="0">
              <MatchValueList />
            </Matcher>
          </Matchers>
        </Group>
      </GroupMatchers>
      <MatcherMode>And</MatcherMode>
      <AndOrNot>And</AndOrNot>
    </ComicList>
  </ComicLists>
</ComicDatabase>
